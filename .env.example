# ============================================
# 智能任务管理系统 - 环境变量配置
# 使用方法：复制本文件为 .env，然后填入你的真实值
#   cp .env.example .env
# ============================================

# Supabase 项目地址
# 获取路径：Supabase 控制台 -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://你的项目地址.supabase.co

# Supabase publishable key（公共密钥）
# 获取路径：Supabase 控制台 -> Project Settings -> API -> Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=你的publishable密钥

# 服务端口（默认 3000，一般无需修改）
PORT=3000
